# Copy this file to `.env` and fill in your keys.

# Required: your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Recommended: an email so NCBI/Unpaywall can contact you about heavy usage.
# Unpaywall REQUIRES an email; PubMed strongly recommends one.
CONTACT_EMAIL=you@example.com

# Optional: an NCBI API key raises the PubMed rate limit from 3 to 10 req/sec.
# https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# Optional: override the Claude model (defaults to claude-opus-4-8)
MEDRAG_MODEL=claude-opus-4-8
