# Copy this file to `.env` and adjust as needed.
# With the defaults below, MedRAG runs FULLY LOCALLY and FREE via Ollama —
# no API key required.

# --- Answer generation ---------------------------------------------------
# "ollama" (local dev, default), "groq" (free hosted — for the public site),
# or "anthropic" (Claude API).
MEDRAG_PROVIDER=ollama

# Ollama: the local model to use. Install Ollama (https://ollama.com), then:
#   ollama pull llama3.1
MEDRAG_OLLAMA_MODEL=llama3.1
# OLLAMA_HOST=http://localhost:11434

# Groq (free hosted) — set these when MEDRAG_PROVIDER=groq (the public site).
# Free key: https://console.groq.com/keys
# GROQ_API_KEY=gsk_...
# MEDRAG_GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic (Claude) — ONLY needed if MEDRAG_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=sk-ant-...
# MEDRAG_MODEL=claude-sonnet-4-6

# --- PubMed / Unpaywall --------------------------------------------------
# Recommended: an email so NCBI/Unpaywall can contact you about heavy usage.
# Unpaywall REQUIRES an email to return open-access links.
CONTACT_EMAIL=you@example.com

# Optional: an NCBI API key raises the PubMed rate limit from 3 to 10 req/sec.
NCBI_API_KEY=
